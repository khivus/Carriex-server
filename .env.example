# Copy to .env beside README.md. Replace HOST with your computer's reachable IP.
# No https:// and no port in HOST. IPv6 addresses can be written without brackets.
CARRIEX_HOST=192.168.0.34
# One port for both the phone address and the native/Docker host port.
# 443 works too: phones then use https://192.168.0.34 (no :443 needed).
CARRIEX_PORT=8443
CARRIEX_SERVER_NAME='Carriex-server'

# Advanced native settings (usually leave commented):
# CARRIEX_BIND=0.0.0.0
# CARRIEX_LISTEN_PORT=8443  # Only if a router maps public port to a different local port.
# CARRIEX_IDENTITY_DIR=.carriex-server
# CARRIEX_MESSAGE_TTL_SECONDS=2592000  # 30 days for undelivered messages.
# Optional: copy public pairing.html, pairing.png, and pairing.json to a folder.
# The native server creates this folder on startup if needed.
# Keep this separate from the private identity directory. Use a path on this machine.
# CARRIEX_PAIRING_EXPORT_DIR=./pairing-export
# Restart after changes. QR/text refresh automatically; the identity key is preserved.
