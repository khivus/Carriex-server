# ==============================================================================
# CARRIEX SERVER SETTINGS
# Server version: 0.5.0  |  Settings template revision: 1
# ==============================================================================
# Copy this file to .env in the server repository root, beside README.md.
# Lines starting with # are comments. Optional settings also start with #;
# remove that leading # only when you want to use the setting.
# Keep each setting once. Quote names or paths containing spaces or #.
# Native values are literal: no $VARIABLE expansion or shell commands.
# Shell/container environment values override matching settings in this file.


# ==============================================================================
# 01 | CONNECTION AND SERVER NAME
# ==============================================================================
# These settings tell phones where to connect and which server name to display.
# Use an address reachable from the phones, such as this computer's LAN IP.
# Do not put https://, a port, path, spaces, credentials, query, or fragment in HOST.
# IPv6 may be written without brackets. Wildcard addresses 0.0.0.0 and :: are
# for listening, not phone connections; localhost only reaches the same device.
# DNS labels allow at most 63 characters; the complete HTTPS address allows 512.
# Do not combine HOST/PORT with the legacy CARRIEX_PUBLIC_URL address setting.
# Port 443 omits :443 in the phone address. Native ports below 1024 may require
# extra OS privileges; use 8443 or Docker's port mapping instead.

# Phone address | reachable IP or hostname only; no scheme, port, or path.
CARRIEX_HOST=192.168.0.34

# Public port | whole number 1-65535; default: 8443.
CARRIEX_PORT=8443

# Display name | 1-80 printable characters; not blank; no control characters.
CARRIEX_SERVER_NAME='Carriex-server'


# ==============================================================================
# 02 | OPTIONAL STATISTICS
# ==============================================================================
# Collects hourly measurements in messages.sqlite3 for practical-work reports.
# Collection is disabled by default. Enabling it does not expose a public page;
# view the saved measurements separately with python -m src.statistics serve.
# Retention is measured in DAYS, not seconds. Only 1 through 365 are allowed.
# Invalid retention stops startup EVEN WHEN COLLECTION IS DISABLED.

# Collection | 0=disabled, 1=enabled; default: 0.
# CARRIEX_STATISTICS=1

# History retention | whole number 1-365 DAYS; default: 30; 1000 is invalid.
# CARRIEX_STATISTICS_RETENTION_DAYS=30


# ==============================================================================
# 03 | ADVANCED NATIVE NETWORKING
# ==============================================================================
# These overrides apply to the native .bat/.sh/Python server, not standard Docker.
# BIND selects a numeric local IP: 0.0.0.0 listens on all IPv4 interfaces,
# 127.0.0.1 allows only local connections, and :: listens on IPv6 interfaces.
# Change LISTEN_PORT only when a router maps the public port to a different
# local port. Otherwise it follows the port in the phone-facing address.
# Docker always listens on 8443 internally; use CARRIEX_PORT for its host port.

# Listening interface | numeric local IP, not a hostname; default: 0.0.0.0.
# CARRIEX_BIND=0.0.0.0

# Listening port | whole number 1-65535; default: public-address port.
# CARRIEX_LISTEN_PORT=8443


# ==============================================================================
# 04 | NATIVE IDENTITY AND SAVED DATA
# ==============================================================================
# Stores the private server key and persistent data. Keep this folder to retain
# the same server identity. It must be writable and either new/empty or an
# existing Carriex identity folder, never an unrelated nonempty directory.
# Native relative paths resolve from the launcher's folder.
# Docker uses its server-identity volume at /var/lib/carriex instead.

# Private data folder | writable Carriex folder; default: .carriex-server.
# CARRIEX_IDENTITY_DIR=.carriex-server


# ==============================================================================
# 05 | MESSAGE EXPIRY
# ==============================================================================
# Controls how long undelivered encrypted messages remain queued on the server.
# Applies to native and Docker deployments. The unit is SECONDS, not days.
# Default: 2592000 seconds = 30 days. Another example: 86400 seconds = 1 day.
# The server requires a positive whole number. For Android compatibility, do not
# exceed 31536000 seconds (365 days), the maximum supported by Android clients.

# Message lifetime | whole SECONDS greater than 0; Android maximum: 31536000.
# CARRIEX_MESSAGE_TTL_SECONDS=2592000


# ==============================================================================
# 06 | OPTIONAL PUBLIC PAIRING EXPORT
# ==============================================================================
# Copies only the public pairing.html, pairing.png, and pairing.json files.
# The export directory must be outside the private identity directory.
# Native launchers create a missing folder; relative paths use the launcher folder.
# Docker needs an existing host folder writable by the container's carriex user.
# Use an absolute host path and add compose.pairing-export.yaml for Docker;
# the full command is in docs/PAIRING.md. Leave commented to disable extra copies.

# Export folder | nonblank path outside private data; an existing file is invalid.
# CARRIEX_PAIRING_EXPORT_DIR=./pairing-export


# ==============================================================================
# 07 | CHECK AND APPLY YOUR CHANGES
# ==============================================================================
# Preview core settings before restarting, without a listener or new keys.
# Storage access and message TTL are also checked when the server actually starts.
#
# Windows check:     .\start-server.bat --check-config
# Linux/macOS check: sh start-server.sh --check-config
# Docker check:     see "Check settings before startup" in docs/PAIRING.md.
#
# Native: restart the server after editing .env.
# Docker: docker compose up -d applies changed container environment values;
# a plain docker compose restart does not reload them.
# QR/text refresh automatically; preserve the identity folder/volume to keep its key.
# More details: docs/PAIRING.md and docs/STATISTICS.md.
